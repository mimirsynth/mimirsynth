# Solo lo necesario para arrancar y conectar. El resto (enlaces, límites de documentos, recall, retención de trabajos…) se cambia en Administración → Ajustes;
# si defines aquí alguna de esas variables (p. ej. MIMIRSYNTH_DOC_MAX_MB), solo actúa como valor por defecto.
# Copia a .env y rellena. No lo subas al repositorio (ya está en .gitignore).
# Genera los secretos con: openssl rand -hex 32
POSTGRES_PASSWORD=
MIMIRSYNTH_SESSION_SECRET=
MIMIRSYNTH_FALKOR_HOST=
MIMIRSYNTH_FALKOR_PORT=6379
MIMIRSYNTH_BOOTSTRAP_GRAPHS=          # grafos existentes a adoptar como brains: "slug:Nombre,otro"
MIMIRSYNTH_AUTH_MODE=local            # local (cuentas propias; OIDC opcional, configurable en Administración) | off (solo desarrollo: sin login)
MIMIRSYNTH_PUBLIC_URL=                # https://mimirsynth.example.com (necesaria para OIDC y para los enlaces de invitación)
MIMIRSYNTH_COOKIE_SECURE=false        # true detrás de HTTPS
# OIDC: puedes dejarlo vacío y configurarlo en Administración → Ajustes (aquí solo actúa como valor por defecto inicial).
MIMIRSYNTH_OIDC_ISSUER=               # p. ej. https://id.example.com o https://login.microsoftonline.com/<tenant>/v2.0 (Entra ID)
MIMIRSYNTH_OIDC_CLIENT_ID=
MIMIRSYNTH_OIDC_CLIENT_SECRET=
MIMIRSYNTH_ADMIN_EMAILS=              # opcional: emails que se dan de alta como administrador al entrar por OIDC (coma)
MIMIRSYNTH_EMBEDDING_BASE_URL=       # endpoint OpenAI-compatible de embeddings (p. ej. http://ollama:11434/v1); debe coincidir con el de Graphiti
MIMIRSYNTH_EMBEDDING_MODEL=nomic-embed-text
MIMIRSYNTH_EMBEDDING_DIM=768

# Ingesta (extracción de hechos con Graphiti). Sin esto las propuestas aprobadas se quedan en "aprobada".
# Cualquier endpoint OpenAI-compatible; para modelos razonadores usa un proxy que desactive el "thinking".
MIMIRSYNTH_LLM_BASE_URL=
MIMIRSYNTH_LLM_API_KEY=
MIMIRSYNTH_LLM_MODEL=

# Memoria documental (ficheros subidos). El volumen debe entrar en las copias de seguridad junto con Postgres.
MIMIRSYNTH_DOC_STORE=/data/documents  # volumen con los originales
MIMIRSYNTH_SOURCES_DIR=./sources        # carpeta del host que se monta en solo lectura en /sources; sus subcarpetas se registran como raíces en Administración → Carpetas
