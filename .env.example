# Only what is needed to start and connect. Everything else (document limits, recall, job retention,
# AI providers, folders, OIDC, email...) is changed under Administration -> Settings and applies without a restart.
# If you define any of those variables here, it only acts as the default value.
#
# Copy this file to .env and fill it in. Do not commit it (it is already in .gitignore).
# IMPORTANT: do not put comments at the end of a value line; Docker Compose would read them as part of the value.
# Generate secrets with: openssl rand -hex 32

# PostgreSQL password (required).
POSTGRES_PASSWORD=
# Signs sessions and encrypts the secrets stored in the database (required; if you change it, they must be entered again).
MIMIRSYNTH_SESSION_SECRET=

# Host port on which the application is published.
MIMIRSYNTH_PORT=8000

# FalkorDB: with "docker compose --profile bundled up" use falkordb; if you already have one, put its host here.
MIMIRSYNTH_FALKOR_HOST=falkordb
MIMIRSYNTH_FALKOR_PORT=6379
# Existing graphs adopted as brains on first start, as slug:Name,other:Other (optional).
MIMIRSYNTH_BOOTSTRAP_GRAPHS=

# Authentication: local (own accounts; OIDC optional, configurable under Administration) or off (development only: no sign-in).
MIMIRSYNTH_AUTH_MODE=local
# Public URL, needed for OIDC and for invitation links, e.g. https://mimirsynth.example.com
MIMIRSYNTH_PUBLIC_URL=
# true if you serve the application over HTTPS (recommended).
MIMIRSYNTH_COOKIE_SECURE=false

# Embeddings: OpenAI-compatible endpoint (e.g. Ollama, http://host.docker.internal:11434/v1). It must be the same one Graphiti uses.
MIMIRSYNTH_EMBEDDING_BASE_URL=
MIMIRSYNTH_EMBEDDING_MODEL=nomic-embed-text
MIMIRSYNTH_EMBEDDING_DIM=768

# Ingestion (fact extraction with Graphiti): any OpenAI-compatible endpoint.
# Without this, approved proposals stay "approved". It can also be configured under Administration -> LLM model.
MIMIRSYNTH_LLM_BASE_URL=
MIMIRSYNTH_LLM_API_KEY=
MIMIRSYNTH_LLM_MODEL=

# Document memory. The volume must be included in backups together with PostgreSQL.
# Host folder mounted read-only at /sources; its subfolders are registered as roots under Administration -> Folders.
MIMIRSYNTH_SOURCES_DIR=./sources
