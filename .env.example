# Solo lo necesario para arrancar y conectar. El resto (límites de documentos, recall, retención de trabajos,
# proveedores de IA, carpetas, OIDC, correo...) se cambia en Administración -> Ajustes y se aplica sin reiniciar.
# Si defines aquí alguna de esas variables, solo actúa como valor por defecto.
#
# Copia este fichero a .env y rellénalo. No lo subas al repositorio (ya está en .gitignore).
# IMPORTANTE: no pongas comentarios al final de una línea de valor; Docker Compose los leería como parte del valor.
# Genera los secretos con: openssl rand -hex 32

# Contraseña de PostgreSQL (obligatoria).
POSTGRES_PASSWORD=
# Firma las sesiones y cifra los secretos guardados en la base de datos (obligatoria; si la cambias, hay que volver a introducirlos).
MIMIRSYNTH_SESSION_SECRET=

# Puerto del host en el que se publica la aplicación.
MIMIRSYNTH_PORT=8000

# FalkorDB: con "docker compose --profile bundled up" usa falkordb; si ya tienes uno, pon aquí su host.
MIMIRSYNTH_FALKOR_HOST=falkordb
MIMIRSYNTH_FALKOR_PORT=6379
# Grafos que ya existen y se adoptan como brains en el primer arranque, con el formato slug:Nombre,otro:Otro (opcional).
MIMIRSYNTH_BOOTSTRAP_GRAPHS=

# Autenticación: local (cuentas propias; OIDC opcional, configurable en Administración) o off (solo desarrollo: sin inicio de sesión).
MIMIRSYNTH_AUTH_MODE=local
# URL pública, necesaria para OIDC y para los enlaces de invitación, p. ej. https://mimirsynth.example.com
MIMIRSYNTH_PUBLIC_URL=
# true si sirves la aplicación por HTTPS (recomendado).
MIMIRSYNTH_COOKIE_SECURE=false

# Embeddings: endpoint compatible con OpenAI (p. ej. Ollama, http://host.docker.internal:11434/v1). Debe ser el mismo que usa Graphiti.
MIMIRSYNTH_EMBEDDING_BASE_URL=
MIMIRSYNTH_EMBEDDING_MODEL=nomic-embed-text
MIMIRSYNTH_EMBEDDING_DIM=768

# Ingesta (extracción de hechos con Graphiti): cualquier endpoint compatible con OpenAI.
# Sin esto las propuestas aprobadas se quedan en "aprobada". También se puede configurar en Administración -> Modelo LLM.
MIMIRSYNTH_LLM_BASE_URL=
MIMIRSYNTH_LLM_API_KEY=
MIMIRSYNTH_LLM_MODEL=

# Memoria documental. El volumen debe entrar en las copias de seguridad junto con PostgreSQL.
# Carpeta del host que se monta en solo lectura en /sources; sus subcarpetas se registran como raíces en Administración -> Carpetas.
MIMIRSYNTH_SOURCES_DIR=./sources
