    "@types/d3-zoom": "^3.0.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "oxc-parser": "^0.157.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
