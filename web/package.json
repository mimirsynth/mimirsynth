    "@mantine/hooks": "^9.7.3",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/react-query": "^5.105.3",
    "d3-force": "^3.0.1",
    "d3-force-3d": "^3.0.6",
    "d3-polygon": "^3.0.2",
    "d3-quadtree": "^3.0.2",
    "d3-selection": "^3.0.1",
    "d3-zoom": "^3.0.1",
    "i18next": "^26.7.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
