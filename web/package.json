    "check:ui": "node scripts/check-ui.mjs",
    "prebuild": "node scripts/check-ui.mjs && node scripts/i18n.mjs",
    "i18n": "node scripts/i18n.mjs",
    "test": "node --experimental-strip-types --test \"scripts/*.test.mjs\""
  },
  "dependencies": {
