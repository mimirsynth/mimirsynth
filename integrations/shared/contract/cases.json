{
  "about": "Cases every implementation of the shared client library must pass (docs/AGENT_CLIENT.md). Strings may be a list of fragments, joined, or {\"repeat\": s, \"times\": n}: values shaped like credentials are split so that repository scanners do not take them for real ones. In paths, {root} is a temporary folder.",
  "contract_version": 1,
  "config": [
    {"name": "defaults when there is nothing", "files": {}, "env": {}, "path": "config.json",
     "expect": {"url": "", "brain": "", "token": "", "write_token": "", "timeout": 4, "max_chars": 4000, "recall": true, "news": true,
                "capture": "off", "capture_confidence": 0.3},
     "configured": false},
    {"name": "the file's top level", "files": {"config.json": {"url": "https://m.test/", "brain": "b1", "token": " mst_r ", "write_token": "mst_w", "capture": "draft"}},
     "env": {}, "path": "config.json",
     "expect": {"url": "https://m.test/", "brain": "b1", "token": "mst_r", "write_token": "mst_w", "capture": "draft"},
     "sources": {"brain": "file", "timeout": "default"}, "configured": true},
    {"name": "an environment variable beats the file, an empty one does not count",
     "files": {"config.json": {"url": "https://m.test", "brain": "b1", "token": "t1"}},
     "env": {"MIMIRSYNTH_BRAIN": "b2", "MIMIRSYNTH_TOKEN": "", "MIMIRSYNTH_URL": "   "}, "path": "config.json",
     "expect": {"brain": "b2", "token": "t1", "url": "https://m.test"}, "sources": {"brain": "env", "token": "file"}, "configured": true},
    {"name": "MIMIRSYNTH_CONFIG names the file", "files": {"elsewhere/alt.json": {"brain": "alt"}, "config.json": {"brain": "main"}},
     "env": {"MIMIRSYNTH_CONFIG": "{root}/elsewhere/alt.json"}, "path": null,
     "expect": {"brain": "alt"}},
    {"name": "a missing or broken file is no file", "files": {"config.json": "{not json"}, "env": {"MIMIRSYNTH_BRAIN": "b1"}, "path": "config.json",
     "expect": {"brain": "b1", "timeout": 4}},
    {"name": "a file that is not an object is no file", "files": {"config.json": ["url"]}, "env": {}, "path": "config.json",
     "expect": {"url": "", "capture": "off"}},
    {"name": "booleans from words, numbers and JSON",
     "files": {"config.json": {"news": 0, "recall": "anything"}}, "env": {}, "path": "config.json",
     "expect": {"news": false, "recall": true}},
    {"name": "booleans: off, no, false and 0 are false, whatever their case",
     "files": {}, "env": {"MIMIRSYNTH_RECALL": " Off ", "MIMIRSYNTH_NEWS": "NO"}, "path": "config.json",
     "expect": {"recall": false, "news": false}},
    {"name": "booleans: a JSON false, and a list is unreadable", "files": {"config.json": {"recall": false, "news": ["x"]}}, "env": {}, "path": "config.json",
     "expect": {"recall": false, "news": true}},
    {"name": "numbers from strings", "files": {}, "env": {"MIMIRSYNTH_TIMEOUT": "2.5", "MIMIRSYNTH_MAX_CHARS": " 12000 ", "MIMIRSYNTH_CAPTURE_CONFIDENCE": "0"},
     "path": "config.json", "expect": {"timeout": 2.5, "max_chars": 12000, "capture_confidence": 0}},
    {"name": "numbers that cannot be read, or are out of range, fall back to the default",
     "files": {"config.json": {"timeout": -1, "max_chars": "12k", "capture_confidence": 1.5}}, "env": {}, "path": "config.json",
     "expect": {"timeout": 4, "max_chars": 4000, "capture_confidence": 0.3}},
    {"name": "more numbers that fall back", "files": {"config.json": {"timeout": true, "max_chars": 0, "capture_confidence": "high"}}, "env": {},
     "path": "config.json", "expect": {"timeout": 4, "max_chars": 4000, "capture_confidence": 0.3}},
    {"name": "a fractional max_chars is cut, an integer in a string is read",
     "files": {"config.json": {"max_chars": 2500.9, "timeout": "10"}}, "env": {}, "path": "config.json",
     "expect": {"max_chars": 2500, "timeout": 10}},
    {"name": "infinity and exponents", "files": {}, "env": {"MIMIRSYNTH_TIMEOUT": "inf", "MIMIRSYNTH_MAX_CHARS": "1e3", "MIMIRSYNTH_CAPTURE_CONFIDENCE": "5e-1"},
     "path": "config.json", "expect": {"timeout": 4, "max_chars": 4000, "capture_confidence": 0.5}},
    {"name": "capture: any case", "files": {}, "env": {"MIMIRSYNTH_CAPTURE": "SEND"}, "path": "config.json", "expect": {"capture": "send"}},
    {"name": "capture: drafts is draft", "files": {"config.json": {"capture": "drafts"}}, "env": {}, "path": "config.json", "expect": {"capture": "draft"}},
    {"name": "capture: auto is send", "files": {"config.json": {"capture": "auto"}}, "env": {}, "path": "config.json", "expect": {"capture": "send"}},
    {"name": "capture: anything else is off", "files": {"config.json": {"capture": "on"}}, "env": {}, "path": "config.json", "expect": {"capture": "off"}},
    {"name": "capture: a number is off", "files": {"config.json": {"capture": 1}}, "env": {}, "path": "config.json", "expect": {"capture": "off"}},
    {"name": "a slug or a token written as a number is a string", "files": {"config.json": {"brain": 42}}, "env": {}, "path": "config.json",
     "expect": {"brain": "42"}},
    {"name": "projects: the deepest folder that holds the working directory",
     "files": {"config.json": {"url": "https://m.test", "brain": "b1", "token": "t1", "write_token": "w1",
                               "projects": {"{root}/work/infra": {"brain": "infra", "token": "t2", "write_token": ""}, "{root}/work": {"brain": "work"}}}},
     "env": {}, "path": "config.json", "cwd": "{root}/work/infra/api",
     "expect": {"brain": "infra", "token": "t2", "write_token": "w1", "url": "https://m.test"}, "sources": {"brain": "project", "write_token": "file"}},
    {"name": "projects: a sibling folder",
     "files": {"config.json": {"brain": "b1", "token": "t1", "projects": {"{root}/work/infra": {"brain": "infra"}, "{root}/work": {"brain": "work"}}}},
     "env": {}, "path": "config.json", "cwd": "{root}/work/other", "expect": {"brain": "work", "token": "t1"}},
    {"name": "projects: the folder itself", "files": {"config.json": {"brain": "b1", "projects": {"{root}/work": {"brain": "work"}}}},
     "env": {}, "path": "config.json", "cwd": "{root}/work", "expect": {"brain": "work"}},
    {"name": "projects: a folder whose name only starts the same does not count",
     "files": {"config.json": {"brain": "b1", "projects": {"{root}/work": {"brain": "work"}}}},
     "env": {}, "path": "config.json", "cwd": "{root}/workshop", "expect": {"brain": "b1"}},
    {"name": "projects: a trailing separator does not matter",
     "files": {"config.json": {"brain": "b1", "projects": {"{root}/work/": {"brain": "work"}}}},
     "env": {}, "path": "config.json", "cwd": "{root}/work/sub", "expect": {"brain": "work"}},
    {"name": "projects: without a working directory, none applies",
     "files": {"config.json": {"brain": "b1", "projects": {"{root}/work": {"brain": "work"}}}}, "env": {}, "path": "config.json",
     "expect": {"brain": "b1"}},
    {"name": "projects: an environment variable still wins",
     "files": {"config.json": {"brain": "b1", "projects": {"{root}/work": {"brain": "work", "capture": "send"}}}},
     "env": {"MIMIRSYNTH_BRAIN": "env"}, "path": "config.json", "cwd": "{root}/work", "expect": {"brain": "env", "capture": "send"}},
    {"name": "projects: entries that are not objects are ignored",
     "files": {"config.json": {"brain": "b1", "projects": {"{root}/work": "work", "": {"brain": "x"}}}}, "env": {}, "path": "config.json",
     "cwd": "{root}/work", "expect": {"brain": "b1"}}
  ],
  "redact": [
    {"name": "tokens, headers, URL credentials and assigned secrets, sure or possible",
     "text": ["token ", "ghp_", "a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8", " · Authorization: Bearer abcdefghijklmnop123 · postgres://app:", "S3cr3tPassw0rd", "@db02/x · db_pass", "word = Xk9#mQ2$vL7pW4zR"],
     "expect": "token [secret removed] · Authorization: Bearer [secret removed] · postgres://app:[secret removed]@db02/x · db_password = [secret removed]"},
    {"name": "a private key", "text": ["-----BEGIN RSA ", "PRIVATE KEY-----\nMIIEowA1b2C3d4E5f6G7h8J9k0\n-----END RSA ", "PRIVATE KEY-----"], "expect": "[secret removed]"},
    {"name": "an AWS access key", "text": ["Nota: el valor es ", "AKIA", "Q7RZ4M2K9WXP3T6N", " y nada más."], "expect": "Nota: el valor es [secret removed] y nada más."},
    {"name": "a GitLab token", "text": ["k ", "glpat-", "A1b2C3d4E5f6G7h8J9k0"], "expect": "k [secret removed]"},
    {"name": "a Slack token", "text": ["k ", "xoxb-", "1234567890-A1b2C3d4E5f6G7h8J9k0"], "expect": "k [secret removed]"},
    {"name": "a Slack webhook", "text": ["k ", "https://hooks.slack.com/services/", "T0A1B2C3D/B0E1F2G3H/A1b2C3d4E5f6G7h8J9k0"], "expect": "k [secret removed]"},
    {"name": "a Google API key", "text": ["k ", "AIza", "A1b2C3d4E5f6G7h8J9k0A1b2C3d4E5f6G7h"], "expect": "k [secret removed]"},
    {"name": "an AI provider's key", "text": ["k ", "sk-proj-", "A1b2C3d4E5f6G7h8J9k0A1b2C3d4E5f6G7h8J9k0"], "expect": "k [secret removed]"},
    {"name": "a Stripe key", "text": ["k ", "sk_", "live_", "A1b2C3d4E5f6G7h8J9k0"], "expect": "k [secret removed]"},
    {"name": "an npm token", "text": ["k ", "npm_", "A1b2C3d4E5f6G7h8J9k0A1b2C3d4E5f6G7h8"], "expect": "k [secret removed]"},
    {"name": "a Hugging Face token", "text": ["k ", "hf_", "A1b2C3d4E5f6G7h8J9k0A1b2C3d4E5f6G7"], "expect": "k [secret removed]"},
    {"name": "a Telegram bot token", "text": ["k ", "123456789:AA", "A1b2C3d4E5f6G7h8J9k0A1b2C3d4E5f6G"], "expect": "k [secret removed]"},
    {"name": "a SendGrid key", "text": ["k ", "SG.", "A1b2C3d4E5f6G7h8J9k0Ab.", "A1b2C3d4E5f6G7h8J9k0A1b2C3d4E5f6G7h8J9k0Abc"], "expect": "k [secret removed]"},
    {"name": "a JWT", "text": ["k ", "eyJ", "hbGciOiJIUzI1NiJ9.eyJ", "zdWIiOiIxMjM0NTY3ODkwIn0.A1b2C3d4E5f6G7h8J9k0"], "expect": "k [secret removed]"},
    {"name": "a URL whose password is a placeholder is left", "text": ["postgresql://user:", "password@localhost/db"], "expect": "postgresql://user:password@localhost/db"},
    {"name": "a variable reference is left", "text": ["token = ${GITHUB_TOKEN}"], "expect": "token = ${GITHUB_TOKEN}"},
    {"name": "a short password is left", "text": ["password: hunter2"], "expect": "password: hunter2"},
    {"name": "a path is left", "text": ["secret_path = /etc/mimirsynth/keys/session.key"], "expect": "secret_path = /etc/mimirsynth/keys/session.key"},
    {"name": "a hash or a UUID alone is left", "text": ["sha256: 9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08 uuid 4f9c2a7e-1b3d-4c8e-9a6f-2d5b7e1c3a9f"],
     "expect": "sha256: 9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08 uuid 4f9c2a7e-1b3d-4c8e-9a6f-2d5b7e1c3a9f"},
    {"name": "AWS's documentation example is left", "text": ["AKIA", "IOSFODNN7EXAMPLE"], "expect": "AKIAIOSFODNN7EXAMPLE"},
    {"name": "nothing", "text": [""], "expect": ""}
  ],
  "worth": [
    {"record": {"files": ["a.py"]}, "worth": true},
    {"record": {"files": [], "last_message": {"repeat": "x", "times": 400}}, "worth": true},
    {"record": {"files": [], "last_message": {"repeat": "x", "times": 399}}, "worth": false},
    {"record": {}, "worth": false},
    {"record": {"files": ["a.py"], "ended": true, "sent": null}, "draft": true},
    {"record": {"files": ["a.py"], "ended": false}, "draft": false},
    {"record": {"files": ["a.py"], "ended": true, "sent": {"id": 1}}, "draft": false},
    {"record": {"files": [], "ended": true}, "draft": false}
  ],
  "proposal": [
    {"name": "a session that changed files", "agent": "Codex", "source": "codex", "confidence": 0.3,
     "record": {"session": "s1", "project": "infra", "started": 1794139200, "first_prompt": "rotate the deploy key\nand say where it lives",
                "last_message": "The key lives in Vaultwarden.", "files": ["ops/deploy.sh", "README.md"]},
     "expect": {"name": "Codex: infra — rotate the deploy key", "source": "text", "source_description": "codex session", "origin": "auto", "confidence": 0.3,
                "body": "Codex session in «infra» (2026-11-08).\n\nTask: rotate the deploy key\nand say where it lives\n\nOutcome:\nThe key lives in Vaultwarden.\n\nFiles changed: ops/deploy.sh, README.md"}},
    {"name": "a session with nothing but files, more than twenty", "agent": "Claude Code", "source": "claude-code", "confidence": 0.5,
     "record": {"session": "s2", "started": 1794139200, "files": ["f1", "f2", "f3", "f4", "f5", "f6", "f7", "f8", "f9", "f10", "f11", "f12", "f13", "f14", "f15", "f16", "f17", "f18", "f19", "f20", "f21", "f22"]},
     "expect": {"name": "Claude Code: ? — session", "source_description": "claude-code session", "confidence": 0.5,
                "body": "Claude Code session in «?» (2026-11-08).\n\nFiles changed: f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16, f17, f18, f19, f20 and 2 more"}}
  ],
  "requests": {
    "config": {"url": "https://m.test/", "brain": "b1", "token": "mst_r", "write_token": "mst_w", "timeout": 3},
    "cases": [
      {"name": "recall with the defaults", "call": "recall", "args": {"query": "where does the database run?"},
       "expect": {"method": "POST", "url": "https://m.test/api/brains/b1/recall", "auth": "Bearer mst_r", "timeout": 3,
                  "body": {"query": "where does the database run?", "facts": 6, "chunks": 3, "max_chars": 4000}}},
      {"name": "recall cuts the query and takes its sizes", "call": "recall",
       "args": {"query": {"repeat": "a", "times": 2000}, "facts": 12, "chunks": 6, "max_chars": 12000, "timeout": 15},
       "expect": {"method": "POST", "url": "https://m.test/api/brains/b1/recall", "auth": "Bearer mst_r", "timeout": 15,
                  "body": {"query": {"repeat": "a", "times": 1500}, "facts": 12, "chunks": 6, "max_chars": 12000}}},
      {"name": "news", "call": "news", "args": {},
       "expect": {"method": "POST", "url": "https://m.test/api/brains/b1/news?limit=20&max_chars=4000", "auth": "Bearer mst_r", "timeout": 3, "body": null}},
      {"name": "whoami with the reader token", "call": "whoami", "args": {},
       "expect": {"method": "GET", "url": "https://m.test/api/brains/b1/whoami", "auth": "Bearer mst_r", "timeout": 3, "body": null}},
      {"name": "whoami with another token", "call": "whoami", "args": {"token": "mst_w"},
       "expect": {"method": "GET", "url": "https://m.test/api/brains/b1/whoami", "auth": "Bearer mst_w", "timeout": 3, "body": null}},
      {"name": "remember: redacted, with the write token", "call": "remember",
       "args": {"title": "Deploy key moved", "content": ["The old key ", "ghp_", "a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8", " was revoked."], "confidence": 0.8, "source_description": "codex"},
       "expect": {"method": "POST", "url": "https://m.test/api/brains/b1/proposals", "auth": "Bearer mst_w", "timeout": 20,
                  "body": {"name": "Deploy key moved", "body": "The old key [secret removed] was revoked.", "source": "text", "source_description": "codex",
                           "origin": "agent", "confidence": 0.8}}},
      {"name": "remember without a write token uses the token", "call": "remember", "config": {"write_token": ""},
       "args": {"title": "t", "content": "c"},
       "expect": {"method": "POST", "url": "https://m.test/api/brains/b1/proposals", "auth": "Bearer mst_r", "timeout": 20,
                  "body": {"name": "t", "body": "c", "source": "text", "source_description": "", "origin": "agent"}}}
    ]
  },
  "answers": [
    {"name": "an expired token", "status": 401, "reason": "Unauthorized", "body": "{\"detail\": \"token expired on 2026-11-01\"}",
     "expect": {"status": 401, "detail": "token expired on 2026-11-01", "auth": true}},
    {"name": "a missing scope", "status": 403, "reason": "Forbidden", "body": "{\"detail\": \"this token cannot recall\"}",
     "expect": {"status": 403, "detail": "this token cannot recall", "auth": true}},
    {"name": "a validation error", "status": 422, "reason": "Unprocessable Entity", "body": "{\"detail\": [{\"loc\": [\"body\", \"name\"], \"msg\": \"too long\"}]}",
     "expect": {"status": 422, "detail": "[{\"loc\":[\"body\",\"name\"],\"msg\":\"too long\"}]", "auth": false}},
    {"name": "an answer that is not JSON", "status": 502, "reason": "Bad Gateway", "body": "<html>down</html>",
     "expect": {"status": 502, "detail": "Bad Gateway", "auth": false}},
    {"name": "an empty detail", "status": 500, "reason": "Internal Server Error", "body": "{\"detail\": \"\"}",
     "expect": {"status": 500, "detail": "Internal Server Error", "auth": false}},
    {"name": "success", "status": 200, "reason": "OK", "body": "{\"context\": \"## Facts\"}", "expect": {"value": {"context": "## Facts"}}},
    {"name": "success without a body", "status": 200, "reason": "OK", "body": "", "expect": {"value": {}}}
  ],
  "send": [
    {"name": "a curator token is refused before anything is sent", "whoami": {"role": "curator"},
     "expect": {"error": 403, "calls": ["GET /whoami"], "sent": false}},
    {"name": "a contributor token sends one proposal", "whoami": {"role": "contributor"}, "proposals": {"id": 7, "status": "pending"},
     "expect": {"calls": ["GET /whoami", "POST /proposals"], "auth": "Bearer mst_w", "timeout": 10, "sent": {"id": 7, "status": "pending"}}}
  ]
}
