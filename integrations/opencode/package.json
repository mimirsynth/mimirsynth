{
  "name": "@mimirsynth/opencode",
  "version": "0.1.2",
  "description": "MimirSynth memory for OpenCode: recall before every prompt, what changed at session start, commands to set up, check, search and remember, the brain's MCP server, and an optional, quarantined capture of what each session learned.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/index.js"
  },
  "bin": {
    "mimirsynth-opencode": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.es.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "mimirsynth",
    "memory",
    "recall",
    "mcp"
  ],
  "homepage": "https://github.com/mimirsynth/mimirsynth/tree/main/integrations/opencode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mimirsynth/mimirsynth.git",
    "directory": "integrations/opencode"
  },
  "bugs": "https://github.com/mimirsynth/mimirsynth/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test test/plugin.test.ts test/cli.test.ts",
    "test:live": "node --experimental-strip-types --no-warnings --test test/live.test.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.14.0",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.8.3",
    "zod": "^4.6.7"
  },
  "overrides": {
    "toml": "^5.0.1",
    "zod": "$zod"
  }
}
